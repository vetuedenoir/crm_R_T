# Copier en `.env` (ignoré par git) puis adapter : cp .env.example .env

# --- Base de données ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
# Base des tests d'intégration, créée au premier démarrage de la base (volume vide).
POSTGRES_TEST_DB=crm_test

# Port publié sur la machine hôte (127.0.0.1 uniquement), pour les tests d'intégration et les outils SQL.
# 5433 plutôt que 5432 pour ne pas entrer en conflit avec un PostgreSQL déjà installé.
DB_PORT=5433

# --- API ---
# Connexion à PostgreSQL. Ici : la base publiée sur la machine hôte (voir DB_PORT) ;
# dans Docker, le service `api` utilisera l'hôte `db` et le port 5432.
DATABASE_URL=postgresql://crm:change-me@127.0.0.1:5433/crm
# Optionnels : PORT (défaut 3000), NODE_ENV (development | production | test, défaut development).
